# Baseline security headers — applied to every response
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com https://challenges.cloudflare.com https://www.highrevenueformat.com https://*.profitableratecpmnetwork.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; frame-src https:; connect-src 'self' https://tiupkpabwuefclbrpaef.supabase.co https://challenges.cloudflare.com https://ipwho.is https://v2.jokeapi.dev https://timeapi.io https://restcountries.com https://meme-api.com https://geocoding-api.open-meteo.com https://api.open-meteo.com https://en.wikipedia.org https://dummyjson.com https://dog.ceo https://date.nager.at https://catfact.ninja https://api.imgflip.com https://api.github.com https://api.frankfurter.dev https://api.dictionaryapi.dev https://api.coingecko.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://tiupkpabwuefclbrpaef.supabase.co; frame-ancestors 'self'

# Assets — cache for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# JS and CSS — versioned via ?v= query strings on every reference, so a
# cache-busted URL only ever points at one immutable payload. Safe to cache
# hard and skip revalidation entirely; bumping the ?v= is what invalidates it.
/*.js
  Cache-Control: public, max-age=31536000, immutable

# nexo-prefs runs in <head> synchronously and isn't cache-busted — keep this
# one short so pref changes apply quickly instead of the year-long rule above.
/nexo-prefs.js
  Cache-Control: public, max-age=3600

# pwa-register.js is also unversioned (no ?v=) — same reasoning as above.
/pwa-register.js
  Cache-Control: public, max-age=3600

/*.css
  Cache-Control: public, max-age=31536000, immutable

# HTML — no cache (always fresh)
/*.html
  Cache-Control: no-cache
/pages/*
  Cache-Control: no-cache

# Admin panel — never index, never cache
/pages/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

# Service worker — must always be revalidated so updates roll out promptly
/sw.js
  Cache-Control: no-cache

# Manifest — cache for a day like other static assets
/manifest.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Sitemap / robots — short cache so crawlers see updates reasonably fast
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
